{
  "name": "supereffective-website",
  "version": "3.12.1",
  "private": true,
  "repository": "git@github.com:itsjavi/supereffective.git",
  "license": "MIT",
  "author": "Javi Aguilar https://itsjavi.com",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:data && next build --webpack",
    "build:data": "pnpm run build:data:pokemon && bun run src/lib/data-client/box-presets/join-presets.ts",
    "build:data:pokemon": "bun json:minify src/lib/data-client/pokemon/legacy-pokemon.json",
    "db-migrate": "pnpm prisma migrate deploy",
    "db-studio": "pnpm prisma studio",
    "dev": "rm -rf ./.next && PORT=3001 next dev --webpack",
    "format": "sort-package-json && prettier --cache --ignore-path '.prettierignore' --write ./",
    "json:minify": "bun run scripts/format-json-file.ts --minify",
    "json:unminify": "bun run scripts/format-json-file.ts",
    "lint": "pnpm typecheck && prettier --ignore-path '.prettierignore' --check ./",
    "lint-fix": "pnpm format",
    "prepare": "pnpm prisma generate --schema src/prisma/schema.prisma && sort-package-json",
    "qa": "pnpm quality-checks",
    "quality-checks": "pnpm quality-checks-nobuild && pnpm build",
    "quality-checks-nobuild": "rm -rf .next && pnpm prisma generate --schema src/prisma/schema.prisma && pnpm lint && pnpm test",
    "start": "next start",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-modal": "^3.16.3",
    "resend": "^6.12.3",
    "sass": "^1.99.0",
    "sort-package-json": "^3.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/bun": "^1.3.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "pwa-asset-generator": "^8.1.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "nodemailer": "^6.9.12"
  },
  "packageManager": "pnpm@9.4.0",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  }
}
